{
  "name": "pj1-svg-cli",
  "version": "0.1.0",
  "private": true,
  "description": "PJ1 Phase 1 object-oriented SVG command-line editor",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "cli": "npm run build --silent && node dist/src/main.js",
    "demo": "npm run build --silent && node dist/src/main.js < examples/flowchart.cli",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "test:in-process": "npm run build --silent && node --test --test-isolation=none dist/test/*.test.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "xml-js": "1.6.11"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
