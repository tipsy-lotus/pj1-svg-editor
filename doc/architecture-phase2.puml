@startuml
title Phase 2 当前框架（实际可选插件待接入）
left to right direction
package "启动与宿主\nsrc/main.ts, src/host" as Host {
  [组合根与默认装配] as Main
  [PluginLoader] as Loader
  [PluginHost\n暂存 / 校验 / 发布] as Activation
}
package "CLI 内核" as Core {
  [cli\n分词 / 注册分派 / 树渲染] as CLI
  [application\n会话 / 保存点] as App
  [commands\n编辑事务 / 历史] as Cmd
  [model\n领域对象 / 图形注册] as Model
  [io\nSVG 与文件访问] as IO
  [extensions\n四个接口 / 上下文 / 注册表] as API
}
package "CLI 插件\nplugins" as Plugins {
  [builtin-shapes] as Shapes
  [builtin-commands] as Commands
}
Main --> Loader
Main --> Activation
Main --> Shapes : 代码装配
Main --> Commands : 代码装配
Main --> App
Main --> IO
Loader --> Activation : 配置装配共用注册路径
Activation --> API
Activation --> CLI
Activation --> Model
CLI --> API
CLI --> Model
App --> Cmd
App --> Model
App --> IO
Cmd --> API
Cmd --> Model
Model --> API
IO --> Model
API --> Model : 领域类型
API --> Cmd : 编辑事务契约
API --> CLI : 公开 Token 类型
Shapes --> API
Shapes --> Model
Commands --> API
Commands --> Cmd
Commands --> Model
Commands --> CLI : 公开 Token 类型
note bottom of Loader
  模块名动态解析；没有具体插件映射
end note
note bottom of Core
  内核不导入宿主或插件
  TypeScript 类型依赖也纳入图示
end note
@enduml
