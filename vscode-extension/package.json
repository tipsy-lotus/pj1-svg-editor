{
  "name": "pj1-svg-tools",
  "displayName": "PJ1 SVG Tools",
  "description": "SVG 文件标记与元素大纲",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "main": "./dist/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "pj1Svg.checkActivation",
        "title": "SVG: 检查扩展启动"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p .",
    "check": "tsc -p . --noEmit",
    "test": "npm run compile --silent && node --test test/*.test.cjs",
    "test:in-process": "npm run compile --silent && node --test --test-isolation=none test/*.test.cjs"
  },
  "dependencies": {
    "sax": "1.6.1"
  },
  "devDependencies": {
    "@types/vscode": "~1.85.0",
    "typescript": "^7.0.2"
  }
}
