{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 SVG 扩展",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/vscode-extension",
        "${workspaceFolder}/vscode-extension/examples",
        "${workspaceFolder}/vscode-extension/examples/outline.svg"
      ],
      "outFiles": ["${workspaceFolder}/vscode-extension/dist/**/*.js"],
      "preLaunchTask": "编译 SVG 扩展"
    }
  ]
}
